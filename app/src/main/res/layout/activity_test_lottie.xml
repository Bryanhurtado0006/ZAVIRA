<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"


    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3E5FC">

    <!-- Cielo/Océano (fondo liso) -->

    <!-- ISLA (Card redondeada simulando arena) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardIsla"
        android:layout_width="0dp"
        android:layout_height="220dp"
        app:cardCornerRadius="40dp"
        app:cardUseCompatPadding="true"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#FFE9C7"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">

        <!-- Texto dentro de la isla (puedes poner un logo o imagen si quieres) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Isla ICFES"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#6D4C41"
            android:gravity="center"/>
    </androidx.cardview.widget.CardView>

    <!-- BOTONES DE ÁREAS SOBRE/ALREDEDOR DE LA ISLA -->
    <TextView
        android:id="@+id/btnLectura"
        style="@style/AreaChipStyle"
        android:text="Lectura"
        app:layout_constraintTop_toTopOf="@id/cardIsla"
        app:layout_constraintStart_toStartOf="@id/cardIsla"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/btnMatematicas"
        style="@style/AreaChipStyle"
        android:text="Matemáticas"
        app:layout_constraintTop_toTopOf="@id/cardIsla"
        app:layout_constraintEnd_toEndOf="@id/cardIsla"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/btnCiencias"
        style="@style/AreaChipStyle"
        android:text="Ciencias"
        app:layout_constraintBottom_toBottomOf="@id/cardIsla"
        app:layout_constraintStart_toStartOf="@id/cardIsla"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/btnSociales"
        style="@style/AreaChipStyle"
        android:text="Sociales"
        app:layout_constraintBottom_toBottomOf="@id/cardIsla"
        app:layout_constraintEnd_toEndOf="@id/cardIsla"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/btnIngles"
        style="@style/AreaChipStyle"
        android:text="Inglés"
        app:layout_constraintTop_toBottomOf="@id/cardIsla"
        app:layout_constraintStart_toStartOf="@id/cardIsla"
        app:layout_constraintEnd_toEndOf="@id/cardIsla"
        android:layout_marginTop="10dp"/>

    <!-- Botón extra: Perfil/Estilo -->
    <TextView
        android:id="@+id/btnPerfil"
        style="@style/AreaChipStyle.Secondary"
        android:text="Perfil"
        app:layout_constraintTop_toBottomOf="@id/btnIngles"
        app:layout_constraintStart_toStartOf="@id/cardIsla"
        app:layout_constraintEnd_toEndOf="@id/cardIsla"
        android:layout_marginTop="8dp"/>

    <!-- PANEL SUBTEMAS (aparece al elegir un área) -->
    <LinearLayout
        android:id="@+id/panelSubtemas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:visibility="gone"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnPerfil"
        app:layout_constraintStart_toStartOf="@+id/cardIsla"
        app:layout_constraintEnd_toEndOf="@+id/cardIsla"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tituloArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Área"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#263238"
                android:paddingBottom="8dp"/>

            <LinearLayout
                android:id="@+id/contenedorSubtemas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
