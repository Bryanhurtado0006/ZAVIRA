<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Título de la competencia / bienvenida -->
    <TextView
        android:id="@+id/txtTituloCompetencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Título de la competencia"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Descripción o mensaje de introducción -->
    <TextView
        android:id="@+id/txtDescripcionCompetencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción de la competencia o instrucciones"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <!-- Lista de subtemas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSubtemas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
