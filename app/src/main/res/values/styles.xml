<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OpcionEstilo">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:padding">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">#E0E0E0</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TestOptionRadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:button">@null</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="CustomButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">30dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AlertDialogCustom" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">#FFFFFF</item> <!-- Fondo blanco -->
        <item name="android:textColorPrimary">#000000</item> <!-- Texto negro -->
        <item name="android:textColorSecondary">#000000</item> <!-- Subtexto negro -->
        <item name="android:buttonBarPositiveButtonStyle">@style/AlertButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/AlertButton</item>
    </style>

    <style name="AlertButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#8BC8E4</item> <!-- Botones negros -->
    </style>

    <style name="AreaChipStyle">
        <item name="android:background">#FFFFFF</item>
        <item name="android:padding">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#1565C0</item>
        <item name="android:gravity">center</item>
        <item name="android:backgroundTint">#E3F2FD</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="AreaChipStyle.Secondary">
        <item name="android:background">#FFECB3</item>
        <item name="android:padding">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#BF360C</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">4dp</item>
    </style>











</resources>